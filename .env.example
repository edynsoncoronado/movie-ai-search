# OMDb API key (https://www.omdbapi.com/apikey.aspx). Only used by notebooks/ to download data; the app never calls OMDb.
OMDB_API_KEY=your_api_key_here

# Path to the full OMDb dataset (JSONL). Required by "ingest" unless a path is given on the command line.
MOVIES_DATA_PATH=data/omdb_raw.jsonl

# Servicios del devcontainer (nombres de docker-compose)
DATABASE_URL=postgresql://app:app@postgres:5432/movies
QDRANT_URL=http://qdrant:6333