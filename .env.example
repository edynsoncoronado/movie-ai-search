# OMDb API key (https://www.omdbapi.com/apikey.aspx). Only used by notebooks/ to download data; the app never calls OMDb.
OMDB_API_KEY=your_api_key_here

# Path to the full OMDb dataset (JSONL). Required by "ingest" unless a path is given on the command line.
MOVIES_DATA_PATH=data/omdb_raw.jsonl

# Devcontainer services (docker-compose service names)
DATABASE_URL=postgresql://app:app@postgres:5432/movies
QDRANT_URL=http://qdrant:6333

# Seconds before an unreachable PostgreSQL or Qdrant is reported as unavailable.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
QDRANT_TIMEOUT_SECONDS=5

# Qdrant alias that points to the current keyword (BM25) collection.
QDRANT_KEYWORD_ALIAS=movies_keyword

# fastembed sparse model for keyword search, and the average document length (in tokens) it uses.
# BM25_AVG_LEN is provisional until it is measured on the full catalog.
BM25_MODEL=Qdrant/bm25
BM25_AVG_LEN=60

# Documents sent to Qdrant per upsert while indexing.
INDEX_BATCH_SIZE=256

# Where fastembed caches its models. This path is the devcontainer's hf-cache volume, so models download only once.
FASTEMBED_CACHE_DIR=/root/.cache/huggingface/fastembed

# Log level for the API and the CLI.
LOG_LEVEL=INFO
